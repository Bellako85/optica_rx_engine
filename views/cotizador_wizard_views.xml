<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_optica_cotizador_wizard_form" model="ir.ui.view">
        <field name="name">optica.cotizador.wizard.form</field>
        <field name="model">optica.cotizador.wizard</field>
        <field name="arch" type="xml">
            <form string="Cotizador Óptico"
                  class="o_optica_cotizador_glass">

                <group>
                    <field name="graduacion_id"/>
                    <field name="tipo_general" readonly="1"/>

                    <field name="subtipo"
                           invisible="tipo_general != 'multifocal'"/>
                </group>

                <group string="Series para laboratorio"
                       class="rx-card rx-series"
                       invisible="tipo_general != 'monofocal'">

                    <field name="serie_od" readonly="1"/>
                    <field name="serie_oi" readonly="1"/>

                </group>

                <group string="Configuración Monofocal"
                       class="rx-card rx-monofocal"
                       invisible="tipo_general != 'monofocal'">

                    <!-- Campos auxiliares para los domains -->
                    <field name="materiales_od_disponibles_ids" invisible="1"/>
                    <field name="tratamientos_od_disponibles_ids" invisible="1"/>
                    <field name="materiales_oi_disponibles_ids" invisible="1"/>
                    <field name="tratamientos_oi_disponibles_ids" invisible="1"/>

                    <group string="Ojo Derecho"
                           class="rx-eye rx-eye-od">
                        
                        <field name="material_od_id"
                               domain="[('id', 'in', materiales_od_disponibles_ids)]"/>
                        
                        <field name="tratamiento_od_id"
                               domain="[('id', 'in', tratamientos_od_disponibles_ids)]"/>
                        
                        <field name="producto_od_id" readonly="1"/>
                        <field name="precio_od" readonly="1"/>
                    </group>

                    <group string="Ojo Izquierdo"
                           class="rx-eye rx-eye-oi">
                        
                        <field name="material_oi_id"
                               domain="[('id', 'in', materiales_oi_disponibles_ids)]"/>
                        
                        <field name="tratamiento_oi_id"
                               domain="[('id', 'in', tratamientos_oi_disponibles_ids)]"/>
                        
                        <field name="producto_oi_id" readonly="1"/>
                        <field name="precio_oi" readonly="1"/>
                    </group>

                    <group>
                        <label for="precio_total" string="TOTAL LENTES"/>
                        <field name="precio_total" readonly="1" nolabel="1"/>
                    </group>

                </group>
                
               <group string="Configuración Progresivo"
                       class="rx-card rx-progressive"
                       invisible="tipo_general != 'multifocal' or subtipo != 'progresivo'">

                        <!-- Campos auxiliares para los domains -->
                    <field name="laboratorios_disponibles_ids" invisible="1"/>
                    <field name="disenos_disponibles_ids" invisible="1"/>
                    <field name="materiales_disponibles_ids" invisible="1"/>
                    <field name="tratamientos_disponibles_ids" invisible="1"/>

                    <field name="laboratorio_id"
                           domain="[('id', 'in', laboratorios_disponibles_ids)]"
                           options="{'no_create': True, 'no_open': True}"/>

                    <field name="diseno_id"
                           domain="[('id', 'in', disenos_disponibles_ids)]"
                           options="{'no_create': True, 'no_open': True}"/>

                    <field name="material_id"
                           domain="[('id', 'in', materiales_disponibles_ids)]"
                           options="{'no_create': True, 'no_open': True}"/>

                    <field name="tratamiento_id"
                           domain="[('id', 'in', tratamientos_disponibles_ids)]"
                           options="{'no_create': True, 'no_open': True}"/>

                </group>

                <group string="Resultado"
                       class="rx-card rx-result"
                       invisible="tipo_general == 'monofocal'">

                    <field name="template_id" readonly="1"/>
                    <field name="producto_id" readonly="1"/>
                    <field name="precio" readonly="1"/>

                </group>

                <footer>
                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

    <record id="action_optica_cotizador_wizard" model="ir.actions.act_window">
        <field name="name">Cotizador Óptico</field>
        <field name="res_model">optica.cotizador.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_optica_rx_root"
              name="Óptica RX"
              sequence="90"/>

    <menuitem id="menu_optica_cotizador"
              name="Cotizador"
              parent="menu_optica_rx_root"
              action="action_optica_cotizador_wizard"
              sequence="10"/>

</odoo>
