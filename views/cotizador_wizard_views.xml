<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_optica_cotizador_wizard_form" model="ir.ui.view">
        <field name="name">optica.cotizador.wizard.form</field>
        <field name="model">optica.cotizador.wizard</field>
        <field name="arch" type="xml">
            <form string="Cotizador Óptico">

                <group>
                    <field name="graduacion_id"/>
                    <field name="tipo_general" readonly="1"/>

                    <field name="subtipo"
                           invisible="tipo_general != 'multifocal'"/>
                </group>

                <group string="Series para laboratorio"
                       invisible="tipo_general != 'monofocal'">

                    <field name="serie_od" readonly="1"/>
                    <field name="serie_oi" readonly="1"/>

                </group>

                <group string="Configuración Progresivo"
                       invisible="tipo_general != 'multifocal' or subtipo != 'progresivo'">

                    <field name="laboratorio_id"/>
                    <field name="diseno_id"/>
                    <field name="material_id"/>
                    <field name="tratamiento_id"/>

                </group>

                <footer>
                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

    <record id="action_optica_cotizador_wizard" model="ir.actions.act_window">
        <field name="name">Cotizador Óptico</field>
        <field name="res_model">optica.cotizador.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_optica_rx_root"
              name="Óptica RX"
              sequence="90"/>

    <menuitem id="menu_optica_cotizador"
              name="Cotizador"
              parent="menu_optica_rx_root"
              action="action_optica_cotizador_wizard"
              sequence="10"/>

</odoo>
